# =============================================================================
# EXAMINATION SEATING PLAN PORTAL - ENVIRONMENT VARIABLE TEMPLATE
# =============================================================================
# Copy backend variables to `backend/.env` and frontend variables to `frontend/.env`
# NEVER commit `.env` files or expose SUPABASE_SERVICE_ROLE_KEY in frontend code.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION (Render / FastAPI)
# -----------------------------------------------------------------------------
APP_NAME="Examination Seating Plan Portal API"
APP_VERSION="1.0.0"
APP_ENV=production
LOG_LEVEL=INFO

# Supabase PostgreSQL Connection String (Use Supavisor Session/Transaction Pooler with sslmode=require)
DATABASE_URL=postgresql+psycopg2://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_ECHO=false

# Supabase Storage (Private Bucket: seating-datasets)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...YOUR_SERVICE_ROLE_SECRET
SUPABASE_STORAGE_BUCKET=seating-datasets
SIGNED_URL_EXPIRES_SECONDS=300

# JWT Authentication & Security
JWT_SECRET_KEY=replace-with-a-64-character-cryptographically-random-hex-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Initial Super-Admin Account Bootstrap (Created on first startup if admin_users is empty)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@examportal.edu
INITIAL_ADMIN_PASSWORD=ChangeMeToStrongPassword!2026
INITIAL_ADMIN_FULL_NAME="Chief Examination Controller"

# Allowed Frontend Origins (Vercel Deployment URL)
FRONTEND_URL=https://your-exam-seating-portal.vercel.app
CORS_ORIGINS=https://your-exam-seating-portal.vercel.app

# Upload & Rate Limit Policies
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120

# -----------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (Vercel / Vite React)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=https://exam-seating-portal-api.onrender.com/api/v1
